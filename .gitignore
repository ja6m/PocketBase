# Compilers, Objects & Symbols
*.d, *.o, *.obj, *.lo, *.slo, *.gch, *.pch, *.pdb, *.dSYM/, *.su, *.idb, *.dwo

# Libraries & Executables
*.lib, *.a, *.la, *.lai, *.dll, *.so, *.dylib, *.exe, *.out, *.app

# Build Systems & Directories
build/, Build/, build-*/, bin/, obj/, CMakeFiles/, CMakeCache.txt, cmake_install.cmake, Makefile, install_manifest.txt, compile_commands.json

# Package Managers
vcpkg_installed/, conan/

# IDEs and Editors (VS Code, Visual Studio, CLion, Xcode)
.vscode/, .vs/, .idea/, *.user, *.suo, *.sln.docstates, cmake-build-debug/, cmake-build-release/, *.pbxuser, xcuserdata/

# Logs and Temporaries
*.tmp, *.log, *.bak, *.swp

# Actual database file
pocketdb.log

# Compiled artifacts
build/
pocketbase
